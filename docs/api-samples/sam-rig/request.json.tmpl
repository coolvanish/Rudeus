# path: /v1/responses
# base-url: https://api.meta.ai   (export META_BASE_URL=https://api.meta.ai ; the path above carries /v1)
# content-type: json
# model: sam-3.1
# accept: application/json
# per-prompt: true
# verified: https://dev.meta.ai/docs/sam/segmenting (2026-10-28): same call as sam-cutout, one body part per request
#   (prompts.json: head, arm, leg, wing, tail, body). Input is the stylized sprite PNG; the box token carries
#   x1,y1,x2,y2 in source pixels — enough for squash/stretch pivots even without decoding the mask.
# verified 2026-10-28 by probe: non-streaming reply is {status:"completed", output:[{content:[{type:"output_text", text}]}]}, no top-level output_text.
# store:false — the default store:true persists the inline base64 image; large bodies failed with HTTP 401 at ~600 KB.
# unverified: SAM 3.1 quality on cartoon body parts (no docs claim); this job is a stretch goal (cut line 2).
{
  "model": "sam-3.1",
  "input": [
    {
      "type": "message",
      "role": "user",
      "content": [
        { "type": "input_text", "text": "{{PROMPT}}" },
        { "type": "input_image", "image_url": "data:{{INPUT_MIME}};base64,{{INPUT_B64}}" }
      ]
    }
  ],
  "stream": false,
  "store": false,
  "metadata": { "mask_encoding": "one_bit", "include_confidence": "true" }
}
